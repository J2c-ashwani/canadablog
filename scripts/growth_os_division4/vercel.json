{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/cron/autopilot",
      "dest": "api/cron/autopilot.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/dashboard.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/autopilot",
      "schedule": "0 */4 * * *"
    }
  ]
}
